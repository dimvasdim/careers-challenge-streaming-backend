# Local settings for `npm run start*` (copy to .env). Docker Compose ignores
# this file and sets its own environment. Variables already set in the shell
# win over .env. All optional: the values shown are the defaults (src/config.ts).
DATABASE_URL=postgres://teton:teton@localhost:5433/teton
# PORT=8080
# Worker processes sharing the port; default min(cores, 4). 1 = single process, no cluster.
# WORKERS=4
# Primary only (WORKERS > 1): merged metrics of all workers, on localhost.
# METRICS_PORT=9464
# Postgres connections per worker, at least 2: 1 for the batch writer, the rest
# for reads (+1 for the alarm listener).
# DB_POOL_SIZE=4
# BATCH_MAX_SIZE=2000
# SSE_KEEPALIVE_MS=15000
# Queued events at which a backpressure warning is logged.
# BACKPRESSURE_LOG_DEPTH=5000
